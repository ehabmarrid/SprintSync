    <string name="member_overflow">+%1$d</string>

    <!--
        Hebrew inflects for 1 and for 2 separately, so the singular and dual forms spell
        the number out and drop the digit: "%1$d לוחות פעילים" would render "1 לוחות
        פעילים", which is wrong. Gender follows the noun - לוח and חבר are masculine
        (שני), משימה is feminine (שתי).
    -->
    <plurals name="active_boards">
        <item quantity="one">לוח פעיל אחד</item>
        <item quantity="two">שני לוחות פעילים</item>
        <item quantity="other">%1$d לוחות פעילים</item>
    </plurals>

